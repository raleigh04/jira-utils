# Copy to .env and fill in. .env is gitignored — never commit it.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_BOARD_ID=1

# Optional. If unset, export JIRA_API_TOKEN yourself, e.g. from Keychain:
#   JIRA_API_TOKEN=$(security find-generic-password -a "$USER" -s jira-api-token -w)
# JIRA_API_TOKEN=
